<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:textDirection="rtl"
    android:padding="14dp"
    android:background="@drawable/piano_widget_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎹 نت‌خوان پیانو"
        android:textColor="#173C2C"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_today"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="امروز: ۰ دقیقه"
        android:textColor="#244B39"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_week"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="این هفته: ۰ دقیقه • ۰ روز"
        android:textColor="#244B39"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_month"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="این ماه: ۰ دقیقه • ۰ روز"
        android:textColor="#244B39"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="برای شروع تمرین لمس کن"
        android:textColor="#65816F"
        android:textSize="11sp" />
</LinearLayout>
